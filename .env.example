# Copy to .env and keep .env out of source control. Empty values are deliberate.

# Tencent Cloud ADP management API credentials. Never commit real values.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SESSION_TOKEN=

# Optional stable account/role label for plans that use rotating temporary credentials.
# It is hashed before being written to the plan.
ADP_ACCOUNT_FINGERPRINT=

# Tencent Cloud uses adp.tencentcloudapi.com. Independent ADP uses capi.adp.tencent.com.
ADP_ENDPOINT=adp.tencentcloudapi.com
ADP_CHAT_ENDPOINT=https://wss.lke.cloud.tencent.com/adp/v2/chat
ADP_REGION=ap-guangzhou

# Keep default_space, provide an existing ID, or set ADP_SPACE_ID= and choose a name.
ADP_SPACE_ID=default_space
ADP_SPACE_NAME=IBL Course Design
ADP_SPACE_DESCRIPTION=AI research-based learning course design

ADP_APP_NAME=IBL课程设计助手
ADP_APP_DESCRIPTION=面向教师的AI与研究性学习课程设计Claw应用
ADP_AGENT_NAME=IBL课程设计主Agent
ADP_AGENT_DESCRIPTION=生成整套课程、单节教案、课件和学生物料
ADP_AGENT_INSTRUCTIONS_FILE=config/agent-instructions.txt
ADP_MAX_REASONING_ROUNDS=100

# Select a model returned by DescribeModelList with ModelScene=18.
ADP_MODEL_ID=

# Recommended: upload the ZIP in ADP and set the resulting ID.
ADP_SKILL_ID=
ADP_SKILL_NAME=ibl-course-designer
ADP_SKILL_VERSION=2.1.0

# Optional fallback only. A local ZIP path is not accepted by CreateSkill.
# This value can be a signed/private URL, so it is always redacted and never persisted.
ADP_SKILL_FILE_URL=

ADP_TEST_USER_ID=ibl-course-designer-acceptance
ADP_ACCEPTANCE_FILE=config/acceptance-cases.json
ADP_STATE_FILE=.state/adp-state.json
ADP_HTTP_TIMEOUT_SECONDS=60
ADP_RELEASE_TIMEOUT_SECONDS=600

# Public, ICP-filed HTTPS domain and server-side certificate paths for Nginx.
PUBLIC_DOMAIN=adp.example.com
TLS_CERT_PATH=/etc/letsencrypt/live/adp.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/adp.example.com/privkey.pem
NGINX_ACCESS_LOG=/var/log/nginx/ibl-adp-access.log
PROXY_CA_CERT_PATH=/etc/ssl/certs/ca-certificates.crt
NGINX_CONFIG_PATH=/etc/nginx/conf.d/ibl-course-designer.conf
BACKUP_DIR=/var/backups/ibl-course-designer
NGINX_BIN=nginx
